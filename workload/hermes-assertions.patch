@@ -0,0 +1,39 @@
+package pl.allegro.tech.hermes.consumers.antithesis;
+
+import com.fasterxml.jackson.databind.node.JsonNodeFactory;
+import com.fasterxml.jackson.databind.node.ObjectNode;
+
+/** Builds details objects for Antithesis SDK assertions (added for Antithesis testing). */
+public final class Details {
+  private Details() {}
+
+  private static final java.util.regex.Pattern ID =
+      java.util.regex.Pattern.compile("\"id\"\\s*:\\s*(\\d+)");
+
+  /** The workload's message ids ("id" fields) found in a batch body, for correlating loss. */
+  public static String payloadIds(java.nio.ByteBuffer content) {
+    try {
+      java.nio.ByteBuffer d = content.duplicate();
+      d.rewind();
+      byte[] bytes = new byte[Math.min(d.remaining(), 65536)];
+      d.get(bytes);
+      java.util.regex.Matcher m =
+          ID.matcher(new String(bytes, java.nio.charset.StandardCharsets.UTF_8));
+      StringBuilder sb = new StringBuilder();
+      while (m.find()) {
+        sb.append(sb.length() == 0 ? "" : ",").append(m.group(1));
+      }
+      return sb.toString();
+    } catch (RuntimeException e) {
+      return "error: " + e;
+    }
+  }
+
+  public static ObjectNode of(Object... kv) {
+    ObjectNode node = JsonNodeFactory.instance.objectNode();
+    for (int i = 0; i + 1 < kv.length; i += 2) {
+      node.put(String.valueOf(kv[i]), String.valueOf(kv[i + 1]));
+    }
+    return node;
+  }
+}
